{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && uv run uvicorn mazda_dash.api.app:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "web",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd frontend && npm run dev -- --port 5173 --strictPort"
      ],
      "port": 5173
    },
    {
      "name": "demo-api",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && MAZDA_DB=../db/demo.duckdb uv run uvicorn mazda_dash.api.app:app --port 8000"
      ],
      "port": 8000
    },
    {
      "name": "mobile",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd mobile && npm run dev"
      ],
      "port": 5174
    }
  ]
}
